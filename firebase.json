{
  "hosting": {
    "public": "src",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/pulsejet-rocket",
        "destination": "https://malcolmsturgiscom.wordpress.com/pulsejet-rocket/",
        "type": 301
      },
      {
        "source": "/**",
        "destination": "https://sturgismal.com",
        "type": 301
      }
    ]
  }
}
